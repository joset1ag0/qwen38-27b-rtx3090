#!/bin/sh
# Codex CLI no KAT-Coder local, de qualquer diretório: exporta a chave do .env
# deste repo e usa o profile kat (~/.codex/kat.config.toml). O servidor sobe
# com `make` no repo; sem ele o codex mostra um erro enganoso de "high demand",
# então o wrapper checa a porta antes.
REPO="$(realpath "$(dirname "$(realpath "$0")")/..")"
PORT="${PORT:-18020}"
if ! curl -s -m 2 -o /dev/null "http://127.0.0.1:$PORT/health"; then
    echo "servidor nao esta de pe em 127.0.0.1:$PORT — rode \`make\` em $REPO" >&2
    exit 1
fi
KAT_API_KEY="$(grep '^VLLM_API_KEY=' "$REPO/.env" | cut -d= -f2-)" exec codex --profile kat "$@"
